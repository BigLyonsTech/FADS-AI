{
  "name": "OnboardingTemplate",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "Owning organisation. Enforced by RLS; set server-side only."
    },
    "name": {
      "type": "string",
      "description": "Template name e.g. Standard Onboarding, Remote Staff Onboarding."
    },
    "description": {
      "type": "string"
    },
    "org_type": {
      "type": "string",
      "enum": [
        "small_business",
        "school",
        "church"
      ],
      "description": "Organisation type this template is designed for."
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "information",
              "documentation",
              "contract",
              "assignment",
              "policy",
              "equipment",
              "induction",
              "start_date",
              "other"
            ]
          },
          "default_due_days": {
            "type": "integer",
            "default": 0,
            "description": "Default days from the employee start date to complete this task."
          }
        },
        "required": [
          "title",
          "category"
        ]
      },
      "default": []
    },
    "is_active": {
      "type": "boolean",
      "default": true
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ],
      "default": "live"
    }
  },
  "required": [
    "organisation_id",
    "name",
    "org_type"
  ],
  "rls": {
    "read": {
      "data.organisation_id": {
        "$in": "{{user.data.hr_organisations}}"
      }
    },
    "create": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "update": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "delete": {
      "user_condition": {
        "role": "no_such_role"
      }
    }
  }
}