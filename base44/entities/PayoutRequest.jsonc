{
  "name": "PayoutRequest",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Affiliate's user ID for RLS isolation."
    },
    "affiliate_id": {
      "type": "string"
    },
    "requested_amount": {
      "type": "number",
      "description": "Amount requested for payout."
    },
    "currency": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "processed"
      ],
      "default": "pending"
    },
    "requested_date": {
      "type": "string",
      "format": "date-time"
    },
    "approved_date": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string"
    },
    "rejected_date": {
      "type": "string",
      "format": "date-time"
    },
    "rejected_by": {
      "type": "string"
    },
    "rejection_reason": {
      "type": "string"
    },
    "processed_date": {
      "type": "string",
      "format": "date-time"
    },
    "payout_record_id": {
      "type": "string",
      "description": "PayoutRecord ID when processed."
    },
    "notes": {
      "type": "string"
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ],
      "default": "live"
    }
  },
  "required": [
    "user_id",
    "affiliate_id",
    "requested_amount",
    "currency",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "update": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "delete": {
      "user_condition": {
        "role": "no_such_role"
      }
    }
  }
}