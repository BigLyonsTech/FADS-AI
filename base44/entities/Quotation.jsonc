{
  "name": "Quotation",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "Owning organisation. Enforced by RLS; set server-side only."
    },
    "quotation_number": {
      "type": "string",
      "description": "Server-generated quotation number."
    },
    "customer_id": {
      "type": "string",
      "description": "FinanceContact id."
    },
    "customer_name": {
      "type": "string"
    },
    "customer_email": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "valid_until": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "description": "Denormalised from organisation at creation."
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "inventory_item_id": {
            "type": "string",
            "description": "Optional structured InventoryItem link."
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "unit_price": {
            "type": "number"
          },
          "discount": {
            "type": "number",
            "default": 0
          },
          "tax_rate": {
            "type": "number",
            "default": 0
          },
          "tax_amount": {
            "type": "number",
            "default": 0
          },
          "total": {
            "type": "number",
            "default": 0
          }
        }
      },
      "default": []
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "discount_total": {
      "type": "number",
      "default": 0
    },
    "tax_total": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "terms": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "sent",
        "accepted",
        "declined",
        "expired",
        "converted"
      ],
      "default": "draft"
    },
    "converted_invoice_id": {
      "type": "string",
      "description": "Invoice created from this quotation, when converted."
    },
    "org_snapshot": {
      "type": "object",
      "description": "Organisation details snapshot for historical document rendering."
    },
    "logo_url": {
      "type": "string"
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ],
      "default": "live"
    }
  },
  "required": [
    "organisation_id",
    "quotation_number",
    "customer_id",
    "issue_date",
    "valid_until",
    "currency",
    "total",
    "status",
    "data_mode"
  ],
  "rls": {
    "read": {
      "data.organisation_id": {
        "$in": "{{user.data.authorised_organisations}}"
      }
    },
    "create": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "update": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "delete": {
      "user_condition": {
        "role": "no_such_role"
      }
    }
  }
}