{
  "name": "ReferralLink",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string",
      "description": "Affiliate's user ID for RLS isolation."
    },
    "affiliate_id": {
      "type": "string",
      "description": "Parent AffiliateProfile ID."
    },
    "code": {
      "type": "string",
      "description": "The unique referral code."
    },
    "url_path": {
      "type": "string",
      "description": "Relative URL path: /signup?ref=CODE"
    },
    "visit_count": {
      "type": "integer",
      "default": 0,
      "description": "Anonymous visit counter \u2014 no personal data stored."
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "user_id",
    "affiliate_id",
    "code",
    "url_path"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "update": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "delete": {
      "user_condition": {
        "role": "no_such_role"
      }
    }
  }
}