{
  "name": "InvoicePayment",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "Owning organisation. Enforced by RLS; set server-side only."
    },
    "invoice_id": {
      "type": "string",
      "description": "The invoice this payment is allocated to."
    },
    "finance_transaction_id": {
      "type": "string",
      "description": "The Money In (FinanceTransaction) created for this payment."
    },
    "amount": {
      "type": "number"
    },
    "currency": {
      "type": "string",
      "description": "Denormalised from org at creation."
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "payment_method": {
      "type": "string",
      "enum": [
        "cash",
        "bank_transfer",
        "card",
        "mobile_money",
        "cheque",
        "other"
      ],
      "default": "cash"
    },
    "reference": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ],
      "default": "live",
      "description": "Records are separated by data mode. demo = fictional sample data; live = real organisation data."
    }
  },
  "required": [
    "organisation_id",
    "invoice_id",
    "finance_transaction_id",
    "amount",
    "currency",
    "date"
  ],
  "rls": {
    "read": {
      "data.organisation_id": {
        "$in": "{{user.data.authorised_organisations}}"
      }
    },
    "create": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "update": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "delete": {
      "user_condition": {
        "role": "no_such_role"
      }
    }
  }
}