{
  "name": "Invoice",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "Owning organisation. Enforced by RLS; set server-side only."
    },
    "invoice_number": {
      "type": "string",
      "description": "Auto-generated org-specific number (e.g. INV-2026-0001)."
    },
    "customer_id": {
      "type": "string",
      "description": "FinanceContact id (customer/parent/member)."
    },
    "customer_name": {
      "type": "string",
      "description": "Snapshot of customer name at issue time."
    },
    "customer_email": {
      "type": "string"
    },
    "customer_address": {
      "type": "string"
    },
    "issue_date": {
      "type": "string",
      "format": "date"
    },
    "due_date": {
      "type": "string",
      "format": "date"
    },
    "currency": {
      "type": "string",
      "description": "Denormalised from org at creation."
    },
    "line_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "inventory_item_id": {
            "type": "string",
            "description": "Optional explicit InventoryItem link for Small Business product analytics."
          },
          "quantity": {
            "type": "number",
            "default": 1
          },
          "unit_price": {
            "type": "number"
          },
          "discount": {
            "type": "number",
            "default": 0,
            "description": "Discount amount in org currency."
          },
          "tax_rate": {
            "type": "number",
            "default": 0
          },
          "tax_amount": {
            "type": "number",
            "default": 0
          },
          "total": {
            "type": "number",
            "default": 0
          }
        }
      },
      "default": []
    },
    "subtotal": {
      "type": "number",
      "default": 0
    },
    "discount_total": {
      "type": "number",
      "default": 0
    },
    "tax_total": {
      "type": "number",
      "default": 0
    },
    "total": {
      "type": "number",
      "default": 0
    },
    "amount_paid": {
      "type": "number",
      "default": 0
    },
    "balance": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "draft",
        "issued",
        "part_paid",
        "paid",
        "cancelled"
      ],
      "default": "draft"
    },
    "payment_instructions": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "org_snapshot": {
      "type": "object",
      "description": "Org name/address/tax info snapshot at issue time for PDF."
    },
    "logo_url": {
      "type": "string",
      "description": "Placeholder for future org logo."
    },
    "source_quotation_id": {
      "type": "string",
      "description": "Quotation converted into this invoice, when applicable."
    },
    "last_reminder_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the owner last sent a collection reminder for this invoice. Updated server-side when a reminder is recorded."
    },
    "last_reminder_channel": {
      "type": "string",
      "enum": [
        "whatsapp",
        "email",
        "dm"
      ],
      "description": "Channel of the last reminder sent."
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ],
      "default": "live",
      "description": "Records are separated by data mode. demo = fictional sample data; live = real organisation data."
    }
  },
  "required": [
    "organisation_id",
    "invoice_number",
    "customer_id",
    "issue_date",
    "due_date",
    "currency",
    "total",
    "status"
  ],
  "rls": {
    "read": {
      "data.organisation_id": {
        "$in": "{{user.data.authorised_organisations}}"
      }
    },
    "create": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "update": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "delete": {
      "user_condition": {
        "role": "no_such_role"
      }
    }
  }
}