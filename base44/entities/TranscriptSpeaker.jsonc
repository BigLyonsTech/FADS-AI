{
  "name": "TranscriptSpeaker",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "Owning organisation. Enforced by RLS; set server-side only."
    },
    "session_id": {
      "type": "string",
      "description": "Parent TranscriptSession ID."
    },
    "name": {
      "type": "string",
      "description": "Speaker display name."
    },
    "role": {
      "type": "string",
      "description": "Optional role label e.g. Chair, Presenter, Participant."
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ],
      "default": "live"
    }
  },
  "required": [
    "organisation_id",
    "session_id",
    "name"
  ],
  "rls": {
    "read": {
      "data.organisation_id": {
        "$in": "{{user.data.authorised_organisations}}"
      }
    },
    "create": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "update": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "delete": {
      "user_condition": {
        "role": "no_such_role"
      }
    }
  }
}