{
  "name": "OffboardingChecklist",
  "type": "object",
  "properties": {
    "organisation_id": {
      "type": "string",
      "description": "Owning organisation. Enforced by RLS; set server-side only."
    },
    "employee_id": {
      "type": "string",
      "description": "Employee this checklist belongs to."
    },
    "template_id": {
      "type": "string",
      "description": "OffboardingTemplate ID this checklist was created from."
    },
    "template_name": {
      "type": "string",
      "description": "Snapshot of template name for display."
    },
    "status": {
      "type": "string",
      "enum": [
        "not_started",
        "in_progress",
        "completed",
        "skipped"
      ],
      "default": "not_started"
    },
    "final_working_date": {
      "type": "string",
      "format": "date",
      "description": "Last working day for the employee."
    },
    "reason_category": {
      "type": "string",
      "enum": [
        "resignation",
        "retirement",
        "termination",
        "contract_end",
        "redundancy",
        "other"
      ],
      "description": "Reason for offboarding."
    },
    "reason_notes": {
      "type": "string",
      "description": "Additional notes about the offboarding reason. Restricted \u2014 HR only."
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "category": {
            "type": "string",
            "enum": [
              "final_date",
              "equipment_return",
              "access_revocation",
              "document_handover",
              "hr_actions",
              "archival",
              "other"
            ]
          },
          "owner_id": {
            "type": "string"
          },
          "owner_name": {
            "type": "string"
          },
          "due_date": {
            "type": "string",
            "format": "date"
          },
          "is_completed": {
            "type": "boolean",
            "default": false
          },
          "completed_date": {
            "type": "string",
            "format": "date"
          },
          "completed_by": {
            "type": "string"
          },
          "completed_by_name": {
            "type": "string"
          },
          "evidence_notes": {
            "type": "string"
          },
          "evidence_file_uri": {
            "type": "string"
          },
          "requires_confirmation": {
            "type": "boolean",
            "default": false,
            "description": "True if this task required explicit confirmation before completion."
          },
          "confirmation_recorded": {
            "type": "boolean",
            "default": false,
            "description": "True if the required confirmation was recorded."
          }
        },
        "required": [
          "title",
          "category"
        ]
      },
      "default": []
    },
    "started_date": {
      "type": "string",
      "format": "date"
    },
    "completed_date": {
      "type": "string",
      "format": "date"
    },
    "archived_employee": {
      "type": "boolean",
      "default": false,
      "description": "True if the employee record has been safely archived (status set to former_employee) as part of offboarding completion."
    },
    "data_mode": {
      "type": "string",
      "enum": [
        "demo",
        "live"
      ],
      "default": "live"
    }
  },
  "required": [
    "organisation_id",
    "employee_id",
    "status"
  ],
  "rls": {
    "read": {
      "data.organisation_id": {
        "$in": "{{user.data.hr_organisations}}"
      }
    },
    "create": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "update": {
      "user_condition": {
        "role": "no_such_role"
      }
    },
    "delete": {
      "user_condition": {
        "role": "no_such_role"
      }
    }
  }
}